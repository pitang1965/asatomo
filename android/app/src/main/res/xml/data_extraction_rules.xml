<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ のバックアップ／端末間移行ルール。
   asatomo.xml（Settings.kt）はログイン情報（セッショントークン・氏名・メール）を含むので、
   Google のクラウドバックアップにも端末間移行にも載せない。新しい端末ではログインし直す
   （アラーム時刻も同じファイルなので移らない。ログイン無しで鳴るだけの目覚ましを残さない方針と整合）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="asatomo.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="asatomo.xml" />
    </device-transfer>
</data-extraction-rules>
