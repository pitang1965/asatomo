# アサトモ 環境変数のひな型（D1移行後。nafuda と同じ file-per-env 方式・staging なし）。
#
# ファイルの使い分け（いずれも .gitignore 済み・コミットしない）:
#   .dev.vars        … ローカル開発のサーバーランタイム秘密情報。@cloudflare/vite-plugin
#                       （Miniflare）が process.env へ流し込む。dev スクリプトもこれを読む。
#   .env.local       … Vite/Node時点のみで使う値（VITE_* クライアント変数、db:studio用の
#                       任意のCloudflare認証情報）。drizzle-kit generate/studio が読む。
#   .env.production   … 本番操作用（VITE_*のビルド埋め込み、db:studio:prod相当の任意認証情報）。
#                       本番Workerの実行時シークレットは wrangler secret put 側（このファイルではない）。
#
# DBはCloudflare D1（本番/開発で別データベース、docs/adr/0012）。dev スクリプトはローカルD1
# ファイル（.wrangler/state配下）に直結するため、本番を指す接続情報自体が存在しない
# （＝構造的に本番を触れない）。
#
# セットアップ:
#   1. このファイルを .dev.vars にコピーして開発用の値を入れる。
#   2. 開発D1を作成・マイグレーション: npx wrangler d1 create asatomo-db-dev →
#      wrangler-dev.jsonc に database_id を反映 → npm run db:migrate → npx tsx scripts/seed-dev.ts
#   3. 本番D1へ当てるときだけ: npm run db:migrate:prod

# Better Auth
BETTER_AUTH_SECRET=（ランダムな長い文字列）
# 開発は Vite の 5173 とオリジン一致が必須（vite.config.ts のメモ参照）。
BETTER_AUTH_URL=http://127.0.0.1:5173

# 見守りWeb の公開URL（通知メールのリンク等）。未設定なら BETTER_AUTH_URL にフォールバック。
# 本番でドメインを変えるときは wrangler.jsonc の BETTER_AUTH_URL を更新すれば連動する。
WEB_BASE_URL=

# ソーシャルログイン（OAuth）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# メール送信（Resend）。EMAIL_FROM は検証済みドメイン上のアドレス。未設定なら開発は
# コンソール出力にフォールバック（実送信しない）。
EMAIL_API_KEY=
EMAIL_FROM=no-reply@over40web.club

# 監視tick 縮退時の運営者通報先。
OPERATOR_EMAIL=

# 開発専用の認証バイパス（Authorization: Bearer <secret>:<userId>）。
# ⚠ 本番には絶対に設定しない。Android 実験（OAuth 配線前）用。
DEV_BEARER_SECRET=

# ── ここから下は .env.local / .env.production 専用（.dev.vars には不要） ──────────

# プロダクト解析（PostHog）。VITE_ 接頭辞のためクライアントバンドルに埋め込まれる
# ＝公開キー（phc_...）専用。秘密キーは絶対に置かない。Vite がビルド時にインライン化する
# （dev は .env.local、本番ビルドは .env.production を読む）。未設定なら解析は無効。
# 解析は本番ビルド（import.meta.env.PROD）でのみ有効化されるので、.env.local に入れても
# `vite dev` では送信されない（意図的。開発者本人のセッションで本番データを汚さないため）。
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# drizzle-kit studio（任意、無くても generate/migrate は動く）用のD1直接アクセス情報。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
