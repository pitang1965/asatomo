{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asatomo",
	// カスタムエントリ: TanStack Start の fetch に加え、監視tick（scheduled）を持つ。
	"main": "src/server/worker.ts",
	"compatibility_date": "2026-07-01",
	// nodejs_compat: vars/secrets が process.env に写る前提（src/server/env.ts）。
	"compatibility_flags": [
		"nodejs_compat"
	],
	// 監視tick（時間駆動の状態遷移 T1/T2/T5）。約15分間隔（ADR-0001）。
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	// 非シークレット。シークレット（DATABASE_URL / BETTER_AUTH_SECRET /
	// GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / EMAIL_API_KEY / OPERATOR_EMAIL）は
	// wrangler secret put で登録する。
	// ⚠ DEV_BEARER_SECRET は本番に絶対に設定しない（開発専用バイパス）。
	"vars": {
		"BETTER_AUTH_URL": "https://asatomo.nafuda.me",
		// メール差出人（Resend 検証済みドメイン over40web.club 上のアドレス）。非機密。
		"EMAIL_FROM": "no-reply@over40web.club",
		// Sentry（エラー監視）。DSNは公開前提の値（書き込み専用、秘匿不要）。
		// wrangler-dev.jsonc には意図的に置かない → 開発ではSentry無効（src/server/instrument.server.ts）。
		"SENTRY_DSN": "https://dc7f74e4a69766a21caf05b39a371d2d@o4507994894434304.ingest.de.sentry.io/4512163930898512"
	},
	"observability": {
		"enabled": true
	},
	// asatomo自身の本番D1（Neonからの移行、docs/adr/0012）。database_idは
	// `npx wrangler d1 create asatomo-db-prod` の出力を貼る（Phase 3で確定）。
	// migrations_dir: drizzle-kitの出力先(./drizzle)をwrangler d1 migrationsに見せる（既定は./migrations）。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "asatomo-db-prod",
			"database_id": "f813b2c4-cc66-4830-ade5-0457f81266eb",
			"migrations_dir": "drizzle"
		}
	]
}